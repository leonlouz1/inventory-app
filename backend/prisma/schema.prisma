generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  location  String?  @db.VarChar(200)
  email     String?  @db.VarChar(200)
  // Ship-from address on BOLs
  address   String?  @db.VarChar(300)
  city      String?  @db.VarChar(100)
  state     String?  @db.VarChar(50)
  zip       String?  @db.VarChar(20)
  phone     String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  stock      WarehouseStock[]
  orderLines OrderLine[]
  restocks   Restock[]
  shipments  Shipment[]
  containers Container[]

  @@map("warehouses")
}

model ProductGroup {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(100)
  products Product[]

  @@map("product_groups")
}

model Product {
  id            Int      @id @default(autoincrement())
  sku           String   @unique @db.VarChar(50)
  name          String   @db.VarChar(200)
  brand         String?  @db.VarChar(100)
  category      String?  @db.VarChar(50)
  leadTimeDays  Int      @default(45) @map("lead_time_days")
  groupId       Int?     @map("group_id")
  description   String?  @db.Text
  wholesalePrice Decimal? @map("wholesale_price") @db.Decimal(10, 2)
  retailPrice   Decimal? @map("retail_price") @db.Decimal(10, 2)
  imageUrl      String?  @map("image_url") @db.VarChar(500)
  casePack      Int?     @map("case_pack") // units per case; blank = unknown
  // Shadow SKU: an old SKU that moved to a new one (its "shadow parent").
  // It keeps its own stock; orders on it use that stock first, then the parent's.
  shadowParentId Int?    @map("shadow_parent_id")
  upc           String?  @db.VarChar(50)
  color         String?  @db.VarChar(100)
  productType   String?  @map("product_type") @db.VarChar(100)
  embossment    String?  @db.VarChar(200)
  attributes    Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  group      ProductGroup?    @relation(fields: [groupId], references: [id])
  shadowParent Product?       @relation("ShadowSku", fields: [shadowParentId], references: [id], onDelete: SetNull)
  shadows      Product[]      @relation("ShadowSku")
  stock      WarehouseStock[]
  orderLines OrderLine[]
  restocks   Restock[]

  @@map("products")
}

model WarehouseStock {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  warehouseId Int      @map("warehouse_id")
  onHand      Int      @default(0) @map("on_hand")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("warehouse_stock")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  ROUTED
  ALLOCATED
  SHIPPED
  CANCELLED
}

model Shipment {
  id             Int       @id @default(autoincrement())
  shipmentNumber String    @unique @map("shipment_number") @db.VarChar(50)
  pickupDate     DateTime  @map("pickup_date") @db.Timestamptz
  carrier        String?   @db.VarChar(200)
  csNumber       String?   @map("cs_number") @db.VarChar(100)
  status         String    @default("SCHEDULED") @db.VarChar(20)
  notes          String?
  warehouseId    Int?      @map("warehouse_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  orders    Order[]
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@map("shipments")
}

model Order {
  id           Int         @id @default(autoincrement())
  orderNumber  String      @unique @map("order_number") @db.VarChar(50)
  customer     String      @db.VarChar(200)
  customerPo   String?     @map("customer_po") @db.VarChar(50)
  orderDate    DateTime    @map("order_date") @db.Date
  status       OrderStatus @default(CONFIRMED)
  notes        String?
  shipmentId   Int?        @map("shipment_id")
  invoicedAt   DateTime?   @map("invoiced_at") @db.Timestamptz
  shippedAt    DateTime?   @map("shipped_at") @db.Date
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  lines           OrderLine[]
  linkedRestocks  Restock[]
  shipment        Shipment?   @relation(fields: [shipmentId], references: [id])

  @@map("orders")
}

model OrderLine {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  productId   Int      @map("product_id")
  warehouseId Int?     @map("warehouse_id")
  quantity        Int
  shipDate        DateTime @map("ship_date") @db.Date
  containerNumber String?  @map("container_number") @db.VarChar(100)
  cartonMarking   String?  @map("carton_marking") @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  // Projection queries always filter productId+warehouseId then range on shipDate.
  @@index([productId, warehouseId, shipDate])
  // Orders list view sorts by earliest ship_date across all lines.
  @@index([shipDate])
  @@map("order_lines")
}

model Restock {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  warehouseId  Int      @map("warehouse_id")
  quantity     Int
  expectedDate DateTime @map("expected_date") @db.Date
  supplier     String?  @db.VarChar(200)
  notes        String?
  // Shared tag for SKUs logged together in one multi-SKU shipment (e.g. one
  // container). Purely a display-grouping concern — null for legacy/standalone rows.
  shipmentId     String?  @map("shipment_id") @db.VarChar(40)
  linkedOrderId  Int?      @map("linked_order_id")
  status         String   @default("IN_PRODUCTION") @map("status") @db.VarChar(20)
  receivedAt     DateTime? @map("received_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // The container this line arrives on. `quantity` is what was ordered;
  // `receivedQuantity` is what actually arrived (set when received).
  containerId      Int?    @map("container_id")
  receivedQuantity Int?    @map("received_quantity")

  product      Product   @relation(fields: [productId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  linkedOrder  Order?    @relation(fields: [linkedOrderId], references: [id])
  container    Container? @relation(fields: [containerId], references: [id], onDelete: Cascade)

  // Projection queries always filter productId+warehouseId then range on expectedDate.
  @@index([productId, warehouseId, expectedDate])
  // Restocks list view sorts by expected_date.
  @@index([expectedDate])
  @@map("restocks")
}

// ─── CRM ───────────────────────────────────────────────────────────────────

model Retailer {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(200)
  type      String?  @db.VarChar(100)
  priority  String   @default("1 - Low") @db.VarChar(20)
  notes          String?
  billingAddress String? @map("billing_address") @db.VarChar(300)
  billingCity    String? @map("billing_city") @db.VarChar(100)
  billingState   String? @map("billing_state") @db.VarChar(100)
  billingZip     String? @map("billing_zip") @db.VarChar(20)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  categories   RetailerCategory[]
  contacts     CrmContact[]
  activityLogs ActivityLog[]
  sentItems    SentItem[]

  @@map("retailers")
}

model RetailerCategory {
  id         Int    @id @default(autoincrement())
  retailerId Int    @map("retailer_id")
  category   String @db.VarChar(50)
  buyerName  String? @map("buyer_name") @db.VarChar(200)
  status     String  @default("Not Contacted") @db.VarChar(50)

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@unique([retailerId, category])
  @@map("retailer_categories")
}

model CrmContact {
  id          Int      @id @default(autoincrement())
  retailerId  Int      @map("retailer_id")
  name        String   @db.VarChar(200)
  title       String?  @db.VarChar(200)
  email       String?  @db.VarChar(200)
  directPhone String?  @map("direct_phone") @db.VarChar(50)
  mobilePhone String?  @map("mobile_phone") @db.VarChar(50)
  hqPhone     String?  @map("hq_phone") @db.VarChar(50)
  category    String?  @db.VarChar(50)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@map("crm_contacts")
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  retailerId   Int      @map("retailer_id")
  category     String?  @db.VarChar(50)
  rep          String?  @db.VarChar(100)
  date         DateTime @db.Date
  actionTaken  String   @map("action_taken") @db.VarChar(100)
  notes        String?
  nextStep     String?  @map("next_step") @db.VarChar(200)
  nextStepDate DateTime? @map("next_step_date") @db.Date
  done         Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@index([retailerId, date])
  @@index([nextStepDate, done])
  @@map("activity_logs")
}

model SentItem {
  id               Int      @id @default(autoincrement())
  retailerId       Int      @map("retailer_id")
  category         String?  @db.VarChar(50)
  buyerName        String?  @map("buyer_name") @db.VarChar(200)
  dateSent         DateTime @map("date_sent") @db.Date
  itemSent         String   @map("item_sent") @db.VarChar(100)
  notes            String?
  responseReceived String?  @map("response_received") @db.VarChar(50)
  followUpDate     DateTime? @map("follow_up_date") @db.Date
  done             Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@index([retailerId])
  @@index([followUpDate, done])
  @@map("sent_items")
}

model RetailerType {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("retailer_types")
}

// UPC codes. Travel ranges (24-29) build the 5-digit item number from
// BB brand + SS style + C color, shared across brands. "range" codes name the
// other-category ranges (e.g. 23 Storage & Organization), numbered freely.
model UpcCode {
  id   Int    @id @default(autoincrement())
  kind String @db.VarChar(10) // "brand" | "style" | "color" | "range"
  code String @db.VarChar(2)
  name String @db.VarChar(100)

  @@unique([kind, code])
  @@map("upc_codes")
}

// Which item numbers are marked "In use". Numbers without a row are available.
// The linked product is the one whose SKU equals the item number.
// name/brand/color/category/packSize are typed in for other-category numbers.
model UpcAssignment {
  sku       String   @id @db.VarChar(5)
  inUse     Boolean  @default(false) @map("in_use")
  name      String?  @db.VarChar(200)
  brand     String?  @db.VarChar(100)
  color     String?  @db.VarChar(100)
  category  String?  @db.VarChar(50)
  packSize  Int?     @map("pack_size")
  casePack  Int?     @map("case_pack")
  attributes Json    @default("{}")
  groupId   Int?     @map("group_id")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("upc_assignments")
}

// Category-specific product fields (stored in Product.attributes by key).
// categories: { "<category>": "required" | "optional" }; options: dropdown
// choices (null = typed in), which users can add to while filling in.
model ProductField {
  key        String @id @db.VarChar(50)
  label      String @db.VarChar(100)
  options    Json?
  categories Json   @default("{}")
  sortOrder  Int    @default(0) @map("sort_order")

  @@map("product_fields")
}

// A product family on the UPC page: numbers that are the same product in
// different colors and/or pack sizes.
model UpcGroup {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("upc_groups")
}

// Last ship-to address used on a BOL for each customer, prefilled next time
model ShipToAddress {
  customer   String   @id @db.VarChar(200)
  name       String?  @db.VarChar(200)
  address    String?  @db.VarChar(300)
  city       String?  @db.VarChar(100)
  state      String?  @db.VarChar(50)
  zip        String?  @db.VarChar(20)
  locationNo String?  @map("location_no") @db.VarChar(50)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("ship_to_addresses")
}

// A container of incoming merchandise. Its lines are Restock rows; the ETA,
// warehouse, supplier and status are copied onto each line so stock
// projections and the timeline keep reading lines as before.
model Container {
  id              Int       @id @default(autoincrement())
  containerNumber String?   @map("container_number") @db.VarChar(50)
  poNumber        String?   @map("po_number") @db.VarChar(200)
  supplier        String?   @db.VarChar(200)
  warehouseId     Int       @map("warehouse_id")
  etd             DateTime? @db.Date
  eta             DateTime  @db.Date
  blNumber        String?   @map("bl_number") @db.VarChar(100)
  notes           String?
  status          String    @default("IN_PRODUCTION") @db.VarChar(20)
  receivedAt      DateTime? @map("received_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lines     Restock[]

  @@map("containers")
}
